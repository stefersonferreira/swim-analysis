# Copie para .env e ajuste. Nada aqui é segredo de produção (etapa 1, uso local).

# cpu (qualquer máquina) ou gpu (placa NVIDIA; no Windows, Docker Desktop com WSL2)
COMPOSE_PROFILES=gpu

# Porta do site: http://localhost:8080
WEB_PORT=8080

# Banco local
POSTGRES_USER=swim
POSTGRES_PASSWORD=swim
POSTGRES_DB=swim

# Imagens prontas publicadas pelo CI (docker compose pull). Para compilar na máquina:
# docker compose build
IMAGE_PREFIX=ghcr.io/stefersonferreira/swim-analysis
IMAGE_TAG=latest

# Recusa vídeos abaixo dos requisitos (fps < 30, abaixo de 720p, mais de 4 min)
SWIM_STRICT_INGEST=true

# IA com visão: pré-marca os pontos técnicos de cada quadro (o treinador confirma).
# Sem chave, a função fica desligada e a marcação é só por cliques.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- Pedidos de clientes (página pública /enviar e links /r/...) ----
# Senha da área do treinador. OBRIGATÓRIA antes de abrir o app na internet.
# Vazio = sem login (só para uso no próprio computador).
SWIM_ADMIN_PASSWORD=
# Prazo de entrega prometido ao cliente, em horas
SWIM_TURNAROUND_HOURS=72
# Tamanho máximo do vídeo enviado pelo cliente, em MB
SWIM_PUBLIC_MAX_UPLOAD_MB=400
