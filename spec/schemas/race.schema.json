{
  "$defs": {
    "PoolUnit": {
      "enum": [
        "m",
        "yd"
      ],
      "title": "PoolUnit",
      "type": "string"
    },
    "Stroke": {
      "enum": [
        "freestyle",
        "breaststroke"
      ],
      "title": "Stroke",
      "type": "string"
    }
  },
  "description": "Dados da prova informados no upload.",
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stroke": {
      "$ref": "#/$defs/Stroke"
    },
    "distance": {
      "description": "Distância da prova na unidade da piscina (50, 100)",
      "title": "Distance",
      "type": "integer"
    },
    "pool_length": {
      "default": 25,
      "description": "Comprimento da piscina na unidade da piscina",
      "title": "Pool Length",
      "type": "integer"
    },
    "pool_unit": {
      "$ref": "#/$defs/PoolUnit",
      "default": "m"
    },
    "lane": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lane"
    },
    "cap_color": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cap Color"
    },
    "official_final_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Official Final S"
    },
    "official_splits_s": {
      "description": "Tempos oficiais acumulados ao fim de cada piscina, em ordem",
      "items": {
        "type": "number"
      },
      "title": "Official Splits S",
      "type": "array"
    }
  },
  "required": [
    "stroke",
    "distance"
  ],
  "title": "RaceInfo",
  "type": "object"
}
